# ── Site ────────────────────────────────────────────────────────────────
NODE_ENV=production
# Public address of the site (no trailing slash). Used in emailed links.
APP_BASE_URL=https://jobs.the-nextrep.com
BETTER_AUTH_URL=https://jobs.the-nextrep.com
# Extra comma-separated origins allowed to sign in (e.g. the Railway URL while testing)
BETTER_AUTH_TRUSTED_ORIGINS=
# Long random string (32+ characters). Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=

# ── Database (MySQL 8) ─────────────────────────────────────────────────
# Railway: set DATABASE_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://user:password@host:3306/railway
# true only if your database requires TLS on a public network
DB_SSL=false

# ── Email (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=The NextRep <notifications@the-nextrep.com>
EMAIL_REPLY_TO=info@the-nextrep.com

# ── Stripe ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional — defaults to the existing price IDs
STRIPE_PRICE_SCOUT_QUARTERLY=
STRIPE_PRICE_SCOUT_ANNUAL=
STRIPE_PRICE_PARTNER_QUARTERLY=
STRIPE_PRICE_PARTNER_ANNUAL=

# ── File uploads (profile photos, résumés) ─────────────────────────────
# Must point at persistent storage (Railway volume mounted at /data)
UPLOAD_DIR=/data/uploads

# ── Temporary switches ─────────────────────────────────────────────────
# Leave unset in production. true = admins sign in without the emailed code.
SKIP_ADMIN_2FA=
